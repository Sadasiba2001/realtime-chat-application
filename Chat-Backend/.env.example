# ============================================================
# SB Chat Backend - Environment Configuration Template
# ============================================================

# Django Core
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL - Leave DB_HOST blank for SQLite)
DB_HOST=
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# Redis Cache & Channels (Optional for local dev)
# Leave empty for local development (single process, in-memory cache/channel layer), or point it
# at a Redis used ONLY by this environment (e.g. redis://localhost:6379/0).
# Never reuse a staging/production Redis locally: presence, rate limits, call state and the
# channel layer would be shared with that environment. Tests never use Redis.
REDIS_URL=

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here

# Email / SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SB Chat <no-reply@sbchatwebpro.online>
EMAIL_TIMEOUT=10

# Cloudinary Storage
CLOUD_NAME=
API_KEY=
API_SECRET=
CLOUDINARY_URL=

# WebRTC ICE Servers
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
