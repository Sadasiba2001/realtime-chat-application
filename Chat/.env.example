# Vite Application Environment Template Example
#
# Backend selection (resolved in src/services/backend.config.ts):
#   API:       VITE_API_URL -> VITE_REMOTE_BACKEND_URL -> same origin (Vite dev proxy)
#   WebSocket: VITE_WS_URL  -> derived from the API URL -> browser location
# An explicit VITE_WS_URL is always used as-is.

# ---- Local development (Django running on this machine) ----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_REMOTE_BACKEND_URL=

# ---- Remote backend example (e.g. ngrok / production) ----
# VITE_API_URL=https://your-backend.example.com
# VITE_WS_URL=wss://your-backend.example.com/ws
# VITE_REMOTE_BACKEND_URL=https://your-backend.example.com

# Application Brand Title
VITE_APP_TITLE=SB Chat Web Pro

# API Network Timeout (milliseconds)
VITE_API_TIMEOUT=15000

# Offline / Mock Session Fallback Mode (true/false)
VITE_ENABLE_MOCK_FALLBACK=true
