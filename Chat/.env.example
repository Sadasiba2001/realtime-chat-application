# Vite Application Environment Template Example

# Backend API Base URL (Empty string = uses Vite local dev proxy to bypass browser CORS)
VITE_API_URL=

# Real-time Secure WebSocket Gateway URL (Ngrok Tunnel)
VITE_WS_URL=wss://footwork-vessel-guide.ngrok-free.dev/ws

# Target Ngrok Backend URL (Proxied via Vite dev server)
VITE_REMOTE_BACKEND_URL=https://footwork-vessel-guide.ngrok-free.dev

# Application Brand Title
VITE_APP_TITLE=SB Chat Web Pro

# API Network Timeout (milliseconds)
VITE_API_TIMEOUT=15000

# Offline / Mock Session Fallback Mode (true/false)
VITE_ENABLE_MOCK_FALLBACK=true
